# ===========================================================================
# Copy to .env and fill in. NEVER commit .env - it is in .gitignore.
#
#   cp .env.example .env
#   chmod 600 .env
#
# preflight.sh checks every value below and refuses placeholder text, so
# leaving a CHANGEME in place fails loudly rather than silently deploying.
# ===========================================================================

# ---------------------------------------------------------------------------
# REQUIRED
# ---------------------------------------------------------------------------

# Public URL, must be https, must exactly match the Cloudflare public
# hostname. No trailing slash.
DOMAIN=https://vault.example.com

# Cloudflare Tunnel token. Zero Trust dashboard -> Networks -> Tunnels ->
# your tunnel -> Configure -> copy the token from the Docker install command.
# This token authorises a tunnel into your network. Treat it like a password.
TUNNEL_TOKEN=CHANGEME

# Admin panel token, stored as an ARGON2 HASH - not plaintext. Generate:
#   docker run --rm -it vaultwarden/server:1.34.3 /vaultwarden hash
# Paste the whole $argon2id$v=19$... string. Because it contains $ characters,
# it must be single-quoted here or Docker Compose will try to expand it.
ADMIN_TOKEN='CHANGEME'

# ---------------------------------------------------------------------------
# ACCOUNT CONTROL
# ---------------------------------------------------------------------------

# Keep false. Flip to true only long enough to register your first account,
# then flip back and `docker compose up -d`. See README Step 4.
SIGNUPS_ALLOWED=false

# Require email verification on signup.
SIGNUPS_VERIFY=true

# Lets you invite additional users from /admin without opening signups.
INVITATIONS_ALLOWED=true

# Optional second guard: comma-separated email domains permitted to register
# even if signups are accidentally enabled. Blank = no domain restriction.
SIGNUPS_DOMAINS_WHITELIST=

# Comma-separated emails allowed to create organizations. Blank = all users.
# Set to "none" to forbid organization creation entirely.
ORG_CREATION_USERS=

# ---------------------------------------------------------------------------
# FEATURES
# ---------------------------------------------------------------------------

WEB_VAULT_ENABLED=true
SENDS_ALLOWED=true
EMERGENCY_ACCESS_ALLOWED=true

# "internal" proxies favicon fetches through your server. Set
# DISABLE_ICON_DOWNLOAD=true if you would rather it never contact the sites
# you have logins for (small metadata leak on the server's egress).
ICON_SERVICE=internal
DISABLE_ICON_DOWNLOAD=false

# ---------------------------------------------------------------------------
# MOBILE PUSH  (optional - browser extensions do not need it)
# ---------------------------------------------------------------------------
# Register a free installation id/key at https://bitwarden.com/host/
PUSH_ENABLED=false
PUSH_INSTALLATION_ID=
PUSH_INSTALLATION_KEY=

# ---------------------------------------------------------------------------
# SMTP  (required for invitations and email 2FA)
# ---------------------------------------------------------------------------
# Any provider works. If you use Gmail/Fastmail, generate an app-specific
# password rather than using your real one.
SMTP_HOST=
SMTP_FROM=
SMTP_FROM_NAME=Vaultwarden
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USERNAME=
SMTP_PASSWORD=

# ---------------------------------------------------------------------------
# LOGGING
# ---------------------------------------------------------------------------
LOG_LEVEL=info

# ===========================================================================
# BACKUP SETTINGS  (read by backup.sh / restore.sh, not by Docker)
# ===========================================================================

# Where nightly archives land on this VM before being shipped off-box.
BACKUP_DIR=/opt/vaultwarden/backups

# How many nightly archives to keep locally.
BACKUP_RETENTION_DAYS=14

# Encryption. "age" is recommended. "gpg" uses a symmetric passphrase.
# "none" is accepted but preflight.sh will WARN - an unencrypted vault
# backup sitting on a NAS is the classic way self-hosted setups get owned.
BACKUP_ENCRYPTION=age

# For BACKUP_ENCRYPTION=age: your age PUBLIC key (age1...). Generate with
#   age-keygen -o ~/.age/vaultwarden.key
# Keep the PRIVATE key somewhere that is NOT this server - if the only copy
# of your decryption key lives on the box you are backing up, you have not
# got a backup.
AGE_RECIPIENT=

# Where restore.sh looks for the age PRIVATE key when decrypting. On the
# production VM this should normally be left blank/absent; you supply it on
# the recovery machine at restore time.
AGE_IDENTITY_FILE=

# For BACKUP_ENCRYPTION=gpg: path to a file containing the passphrase.
GPG_PASSPHRASE_FILE=

# Off-box destination, passed straight to rsync. Blank = local only, which
# preflight.sh will WARN about. Examples:
#   BACKUP_REMOTE=user@nas.lan:/volume1/backups/vaultwarden/
#   BACKUP_REMOTE=/mnt/pbs-share/vaultwarden/
BACKUP_REMOTE=
